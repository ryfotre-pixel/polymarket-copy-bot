# Copy this file to ".env" and fill it in. Never share your .env with anyone.

# --- Who to copy -------------------------------------------------------------
# The whale's Polymarket (international) proxy wallet address, 0x...
TARGET_PROXY_WALLET=

# --- Safety switch ------------------------------------------------------------
# true  = simulate only: logs what it WOULD do, never places an order.
# false = LIVE: places real orders with real money on your Polymarket US account.
DRY_RUN=true

# --- Polymarket US API keys (create at https://polymarket.us/developer) --------
# Optional in dry-run mode. If set in dry-run, the bot also asks Polymarket US to
# "preview" each order, which checks it without placing it.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# --- Money ----------------------------------------------------------------------
# Total money the bot may have in open copied positions at once.
USER_BANKROLL_USD=90
# Money you add (+) or withdraw (-) after starting. Bets size from bankroll + this + results,
# but it is never counted as profit or loss. Keep a running total, e.g. 10, then 60 after adding $50.
ADDED_FUNDS_USD=0
# Bets grow and shrink with wins and losses: bankroll = USER_BANKROLL_USD + finished-copy profit/loss.
# The per-market and per-game caps scale with it; MAX_ORDER_USD stays a hard ceiling.
COMPOUND_BANKROLL=true

# How to size each copied trade:
#   fixed_pct   = USER_BANKROLL_USD x PCT_PER_TRADE on every trade (recommended)
#   whale_ratio = whale's trade dollars x (USER_BANKROLL_USD / WHALE_BANKROLL_USD)
SIZING_MODE=fixed_pct
PCT_PER_TRADE=0.05
WHALE_BANKROLL_USD=50000

# Every order is clamped to this range (dollars).
MIN_ORDER_USD=1
MAX_ORDER_USD=10
# Most dollars the bot will put into any one market (stops it piling into the same bet
# every time the whale adds to it).
MAX_PER_MARKET_USD=10
# Most dollars on any one game across all its bets (winner, spreads, totals). The whale often
# bets several nearby lines of one game; those win or lose together, so this spreads the risk.
MAX_PER_GAME_USD=10
# Ignore whale trades smaller than this (dollars). Tiny trades say little about conviction.
MIN_WHALE_TRADE_USD=50

# --- Price protection -----------------------------------------------------------
# Skip a copy if our price would be worse than the whale's by more than this ($).
MAX_SLIPPAGE_CENTS=0.03
# Ignore whale trades older than this many seconds when we first see them.
MAX_TRADE_AGE_SEC=90

# --- Stop rules -----------------------------------------------------------------
# Stop opening new copies once you could lose this many dollars. Open bets count as lost until
# their games finish, so total losses can never go past this number. 0 = off.
MAX_LOSS_USD=40
# Stop opening new copies if, on average, we pay more than this ($) over the whale's price.
# Checked only after SLIPPAGE_MIN_FILLS filled buys. 0 = off.
MAX_AVG_SLIPPAGE_CENTS=0.025
SLIPPAGE_MIN_FILLS=10
# When a rule stops the bot, open copies stay until their games finish and whale sells are still
# copied. Raise the limit here and restart to resume.

# --- What to copy ---------------------------------------------------------------
# Any of: moneyline, spread, total, soccer_winner
MARKET_KINDS=moneyline,spread,total,soccer_winner
# Only copy these leagues (start of the event slug: nba, nfl, epl, ...). Empty = every league.
# The backtest only covered nba.
LEAGUES=nba
# Copy the whale's sells (exit our matching position)?
COPY_EXITS=true

# --- Timing ---------------------------------------------------------------------
POLL_MS=2500
# How often to check whether games we copied have finished and settled (60000 = every minute).
SETTLE_CHECK_MS=60000

# Phone notifications (live bot only): install the ntfy app (ntfy.sh), subscribe to a long random topic name,
# and put that name here. Anyone who knows the name can read the messages, so keep it private. Empty = off.
NTFY_TOPIC=
